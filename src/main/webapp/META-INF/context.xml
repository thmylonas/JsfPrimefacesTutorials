<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<Context reloadable="true">

    <!--
    Alternative options
    **********************
    java:comp/env/
    driverClassName="oracle.jdbc.driver.OracleDriver"
    -->
    <Resource
            name="jdbc/oracledb"
            type="javax.sql.DataSource"
            auth="Container"
            driverClassName="oracle.jdbc.OracleDriver"
            url="jdbc:oracle:thin:@localhost:1521:oracledb"
            username="schooldb"
            password="aaaa"
            maxTotal="20"
            maxIdle="10"
            maxWaitMillis="-1"
            minPoolSize="2"
            maxPoolSize="60"
            initialPoolSize="15"
            autoCommit="false"/>

    <!--
    https://tomcat.apache.org/tomcat-9.0-doc/config/globalresources.html
    ***********************************************************************
    <ResourceLink
            name="jdbc/oracledb"
            global="jdbc/oracledb"
            type="javax.sql.Datasource"/>
    -->
</Context>

