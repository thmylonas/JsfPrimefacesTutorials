<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<Context reloadable="true">

    <Resource
            name="jdbc/studentdb"
            type="javax.sql.DataSource"
            auth="Container"
            driverClassName="org.h2.Driver"
            url="jdbc:h2:mem:studentdb;DB_CLOSE_DELAY=-1"
            username="sa"
            password=""
            maxTotal="20"
            maxIdle="10"
            maxWaitMillis="-1"
            minPoolSize="2"
            maxPoolSize="60"
            initialPoolSize="15"
            autoCommit="false"/>

