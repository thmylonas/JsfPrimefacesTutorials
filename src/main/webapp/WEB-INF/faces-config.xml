<?xml version='1.0' encoding='UTF-8'?>

<faces-config version="2.2" xmlns="http://xmlns.jcp.org/xml/ns/javaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-facesconfig_2_2.xsd">

    <application>
        <locale-config>
            <default-locale>en</default-locale>
            <supported-locale>en</supported-locale>
            <supported-locale>el</supported-locale>
        </locale-config>

        <resource-bundle>
            <!--
            The following does not work for UTF-8 charset:
            <base-name>resource_bundles.messages</base-name>
            -->
            <base-name>com.thomasmylonas.spring_mvc_jsf_pf_web_app.view_layer.Messages</base-name>
            <var>msg</var>
        </resource-bundle>
    </application>
</faces-config>
